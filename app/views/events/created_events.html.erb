<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 fw-bold">My Created Events</h1>
  <% if policy(Event.new).create? %>
    <%= link_to new_event_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i> New Event
    <% end %>
  <% end %>
</div>

<% if @events.empty? %>
  <div class="text-center py-5 text-muted">
    <i class="bi bi-calendar-x fs-1"></i>
    <p class="mt-2">You have not created any events yet.</p>
    <% if policy(Event.new).create? %>
      <%= link_to "Create Event", new_event_path, class: "btn btn-primary btn-sm mt-2" %>
    <% end %>
  </div>
<% else %>
  <div class="row g-4">
    <% @events.each do |event| %>
      <%= render "event_card", event: event %>
    <% end %>
  </div>
  <div class="mt-4 d-flex justify-content-center">
    <%= paginate @events %>
  </div>
<% end %>
