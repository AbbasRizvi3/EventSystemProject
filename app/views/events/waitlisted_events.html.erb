<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 fw-bold">My Waitlisted Events</h1>
  <%= link_to events_path, class: "btn btn-outline-secondary btn-sm" do %>
    <i class="bi bi-grid me-1"></i> Browse All Events
  <% end %>
</div>

<% if @events.empty? %>
  <div class="text-center py-5 text-muted">
    <i class="bi bi-hourglass fs-1"></i>
    <p class="mt-2">You are not on the waitlist for any events.</p>
    <%= link_to "Browse Events", events_path, class: "btn btn-primary btn-sm mt-2" %>
  </div>
<% else %>
  <div class="row g-4">
    <% @events.each do |event| %>
      <%= render "event_card", event: event %>
    <% end %>
  </div>
  <div class="mt-4 d-flex justify-content-center">
    <%= paginate @events %>
  </div>
<% end %>
