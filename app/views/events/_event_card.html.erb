<div class="col-md-6 col-lg-4">
  <div class="card h-100 shadow-sm border-0">
    <% if local_assigns[:registered] %>
      <div class="card-header bg-success text-white py-1 px-3 small fw-semibold border-0">
        <i class="bi bi-check-circle me-1"></i> Registered
      </div>
    <% elsif local_assigns[:waitlisted] %>
      <div class="card-header bg-warning text-dark py-1 px-3 small fw-semibold border-0">
        <i class="bi bi-hourglass-split me-1"></i> Waitlisted
      </div>
    <% end %>
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <h5 class="card-title fw-bold mb-0"><%= link_to event.title, event_path(event), class: "text-decoration-none text-dark" %></h5>
        <span class="badge <%= event.active? ? 'bg-success' : 'bg-danger' %>"><%= event.status.capitalize %></span>
      </div>
      <p class="text-muted small mb-1"><i class="bi bi-geo-alt me-1"></i><%= event.location %></p>
      <p class="text-muted small mb-1"><i class="bi bi-calendar me-1"></i><%= event.start_time.strftime("%b %d, %Y %H:%M") %></p>
      <p class="text-muted small"><i class="bi bi-people me-1"></i>Capacity: <%= event.capacity %></p>
    </div>
    <div class="card-footer bg-transparent border-0">
      <%= link_to "View Details", event_path(event), class: "btn btn-outline-primary btn-sm w-100" %>
    </div>
  </div>
</div>
